{
  auto_https off
}

# ---------- APP ----------
task.planelocal:80 {
  encode zstd gzip
  header {
    X-Forwarded-Proto {scheme}
  }

  @api path /api/* /socket.io/* /ws/* /auth/*
  reverse_proxy @api api:8000

  reverse_proxy web:3000
}

# ---------- ADMIN / GOD MODE ----------
admin.task.planelocal:80 {
  encode zstd gzip
  header {
    X-Forwarded-Proto {scheme}
  }

  @api path /api/* /socket.io/* /ws/* /auth/*
  reverse_proxy @api api:8000

  reverse_proxy admin:3000
}

# ---------- SPACE ----------
space.task.planelocal:80 {
  encode zstd gzip
  header {
    X-Forwarded-Proto {scheme}
  }

  @api path /api/* /socket.io/* /ws/* /auth/*
  reverse_proxy @api api:8000

  reverse_proxy space:3000
}