services:
  web:
    ports: ["127.0.0.1:3000:3000"]
    env_file: [ ./plane.env ]
    environment:
      APP_PROTOCOL: "https"
      WEB_URL: "https://task.abcvip.site"
      CORS_ALLOWED_ORIGINS: "https://task.abcvip.site,https://148.113.10.170"
      CSRF_TRUSTED_ORIGINS: "https://task.abcvip.site,https://148.113.10.170"
      ALLOWED_HOSTS: "task.abcvip.site,148.113.10.170,localhost,127.0.0.1"

  api:
    ports: ["127.0.0.1:8000:8000"]
    env_file: [ ./plane.env ]
    environment:
      APP_PROTOCOL: "https"
      WEB_URL: "https://task.abcvip.site"
      CORS_ALLOWED_ORIGINS: "https://task.abcvip.site,https://148.113.10.170"
      CSRF_TRUSTED_ORIGINS: "https://task.abcvip.site,https://148.113.10.170"
      ALLOWED_HOSTS: "task.abcvip.site,148.113.10.170,api,localhost,127.0.0.1"
      ENABLE_EMAIL_PASSWORD: "1"
      ENABLE_SIGNUP: "1"
      ENABLE_MAGIC_LINK_LOGIN: "0"

  beat-worker:
    env_file: [ ./plane.env ]
    environment:
      WEB_URL: "https://task.abcvip.site"
      CORS_ALLOWED_ORIGINS: "https://task.abcvip.site,https://148.113.10.170"

  migrator:
    env_file: [ ./plane.env ]
    environment:
      WEB_URL: "https://task.abcvip.site"
      CORS_ALLOWED_ORIGINS: "https://task.abcvip.site,https://148.113.10.170"

