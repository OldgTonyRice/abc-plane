##########################################
# 🌐 BASE CONFIG
##########################################
APP_DOMAIN=148.113.10.170
APP_PROTOCOL=https
WEB_URL=https://task.abcvip.site

ALLOWED_HOSTS=task.abcvip.site,148.113.10.170,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://task.abcvip.site,https://148.113.10.170
CSRF_TRUSTED_ORIGINS=https://task.abcvip.site,https://148.113.10.170

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None
CSRF_COOKIE_HTTPONLY=False
# SESSION_COOKIE_HTTPONLY=True   # (default True)

##########################################
# 🗄️ DATABASE (Postgres)
##########################################
POSTGRES_DB=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_HOST=plane-db
POSTGRES_PORT=5432

##########################################
# 🐇 MESSAGE BROKER (RabbitMQ)
##########################################
RABBITMQ_DEFAULT_USER=plane
RABBITMQ_DEFAULT_PASS=plane
RABBITMQ_DEFAULT_VHOST=/

##########################################
# 🔑 DJANGO / INTERNAL
##########################################
DJANGO_SETTINGS_MODULE=plane.settings.production
DEBUG=1
SECRET_KEY=changeme-in-production

##########################################
# ☁️ MINIO / S3 UPLOADS
##########################################
IS_MINIO_ENABLED=True
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_BUCKET_NAME=uploads
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT=http://plane-minio:9000
AWS_S3_CUSTOM_DOMAIN=https://task.abcvip.site/uploads
AWS_S3_FORCE_PATH_STYLE=True

##########################################
# 📧 EMAIL (optional – placeholder)
##########################################
IS_EMAIL_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@task.abcvip.site
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=Plane <no-reply@task.abcvip.site>

##########################################
# ⚙️ OTHER
##########################################
ENABLE_EMAIL_PASSWORD=1
ENABLE_SIGNUP=1
ENABLE_MAGIC_LINK_LOGIN=0

