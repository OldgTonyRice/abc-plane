services:
  web:
    ports: ["3000:3000"]
    env_file: [ ./plane.env ]
    environment:
      APP_PROTOCOL: "https"
      WEB_URL: "https://148.113.10.170"
      CORS_ALLOWED_ORIGINS: "https://148.113.10.170"
      CSRF_TRUSTED_ORIGINS: "https://148.113.10.170"
      ALLOWED_HOSTS: "148.113.10.170"

  api:
    ports: ["8000:8000"]
    env_file: [ ./plane.env ]
    environment:
      APP_PROTOCOL: "https"
      WEB_URL: "https://148.113.10.170"
      CORS_ALLOWED_ORIGINS: "https://148.113.10.170"
      CSRF_TRUSTED_ORIGINS: "https://148.113.10.170"
      # MỞ RỘNG cho call nội bộ từ adapter (api), debug cục bộ, v.v.
      ALLOWED_HOSTS: "148.113.10.170,api,localhost,127.0.0.1"
      ENABLE_EMAIL_PASSWORD: "1"
      ENABLE_SIGNUP: "1"
      ENABLE_MAGIC_LINK_LOGIN: "0"

  beat-worker:
    environment:
      WEB_URL: "https://148.113.10.170"
      CORS_ALLOWED_ORIGINS: "https://148.113.10.170"

  migrator:
    environment:
      WEB_URL: "https://148.113.10.170"
      CORS_ALLOWED_ORIGINS: "https://148.113.10.170"

  login-adapter:
    image: plane-login-adapter:local
    ports: ["8081:8081"]
    environment:
      # Origin khớp với URL truy cập
      ALLOW_ORIGIN: "https://148.113.10.170"
      # Gọi nội bộ sang API theo service-name
      PLANE_API_BASE: "http://api:8000"
